{
  "expo": {
    "name": "OutThere",
    "slug": "outthere",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "outthere",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.outthere.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "app-1-501902701509-ios-c299e880508a05e43a11ac",
              "com.googleusercontent.apps.501902701509-9ldnpd7ev6m98u0ql17km0lsp679b3h9"
            ]
          }
        ],
        "NSLocationWhenInUseUsageDescription": "Allow OutThere to access your location to discover people and events nearby.",
        "NSCameraUsageDescription": "Allow OutThere to access your camera to take profile photos and verify your account.",
        "NSPhotoLibraryUsageDescription": "Allow OutThere to access your photos so you can upload pictures to your profile.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.outthere.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow OutThere to use your location to discover nearby people and events."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow OutThere to access your photos so you can upload profile pictures."
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/auth",
        {
          "ios": {
            "captchaOpenUrlFix": false
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth"
            ]
          },
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withFirebaseSwiftAppDelegate.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6197dfb-1b99-47b0-b5a9-3b33bba01dbf"
      }
    },
    "owner": "devansh069"
  }
}
